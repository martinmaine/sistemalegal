# Copiar a .env y completar. El .env nunca se sube al repositorio.
# Para el entorno local de docker compose los valores por defecto ya sirven.

# --- Base de datos ---------------------------------------------------------
# Local (docker compose):
POSTGRES_PASSWORD=devpass
POSTGRES_DB=sistemalegal
# Puerto del host para la base. Cambialo si ya tenes otro PostgreSQL en 5432.
PUERTO_DB=5432
# Supabase (produccion): la cadena del POOLER compartido, no la conexion directa.
# Runtime en Render, modo transaccion (puerto 6543):
# DATABASE_URL=postgresql://postgres.abcdefgh:clave@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require
# Migraciones con psql, modo sesion (puerto 5432):
# DATABASE_URL=postgresql://postgres.abcdefgh:clave@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=postgresql://postgres:devpass@localhost:5432/sistemalegal

# --- Backend ---------------------------------------------------------------
PORT=4000
# Orígenes autorizados, separados por coma. En producción, el dominio de Vercel.
CORS_ORIGIN=http://localhost:5173
# Prefijo del proyecto en Vercel, para autorizar los dominios de preview.
CORS_PREFIJO_PREVIEW=sistemalegal
LIMITE_LISTADOS=50
# La CA de Supabase vive en backend/certs/supabase-ca.crt y se usa sola.
# Estas dos solo hacen falta si hay que apuntar a otro certificado:
# DATABASE_CA_CERT_PATH=/ruta/al/certificado.crt
# DATABASE_CA_CERT=-----BEGIN CERTIFICATE-----...

# --- Frontend --------------------------------------------------------------
# URL de la API vista desde el navegador. En Vercel, la URL de Render.
VITE_API_URL=http://localhost:4000

# --- Todavía sin usar (entran con sus módulos) -----------------------------
# JWT_SECRET=
# CLAUDE_API_KEY=
